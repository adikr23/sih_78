DATABASE_URL=sqlite:///./stormtrace.db
JOB_STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
DATA_MODE=SYNTHETIC_DEMO
DATA_PROVIDER=synthetic_demo
FORECAST_AUTO_INGEST=false
TIGGE_AUTO_ENABLED=false
FORECAST_INTERVAL_MINUTES=60
TIGGE_LOOKBACK_CYCLES=4
TIGGE_MAX_LEAD_HOURS=240
TIGGE_REGION=30,70,5,105
TIGGE_ORIGIN=ncmrwf
TIGGE_DATASET=tigge-global
TIGGE_CACHE_DIR=./data/neps_g/auto
VITE_API_BASE_URL=http://127.0.0.1:8000
GRID_SIZE=32
MESH_SUBDIVISIONS=4
N_ENSEMBLE_MEMBERS=8
N_BASELINE_YEARS=30
N_FORECAST_STEPS=8
DIFFUSION_STEPS=50
UPSCALE_FACTOR=2

# Live ERA5/CDS credentials are backend-only. Never place them in frontend env.
# CDS_URL=https://cds.climate.copernicus.eu/api
# CDS_UID=
# CDS_API_KEY=
# ERA5_DATASET=reanalysis-era5-single-levels
# ERA5_VARIABLES=2m_temperature,total_precipitation,10m_u_component_of_wind,10m_v_component_of_wind
# ERA5_DOWNLOAD_AREA=35,-20,0,80
# ERA5_RESOLUTION=0.25/0.25
# ERA5_CACHE_DIR=./data/era5_cache
# ERA5_START_DATE=2020-01-01
# ERA5_END_DATE=2020-01-01
# ERA5_FORECAST_PATH=./data/era5_forecast.nc
# NEPS_G_FORECAST_PATH=./data/neps_g_forecast.nc
# ERA5_CLIMATOLOGY_PATH=./data/era5_climatology.nc
# HIGH_RESOLUTION_TARGET_PATH=./data/high_resolution_reference.nc
# DATA_VARIABLES=t2m,tp,u10,v10
# Set DATA_MODE=LOCAL_REAL for local-only NEPS-G + ERA5 data.
# Set DATA_MODE=REAL for local NEPS-G plus local ERA5 or configured ERA5/CDS.
# Set DATA_MODE=TIGGE_AUTO only when automatic CDS/ECDS retrieval is configured.
# ENSEMBLE_MEMBER=0
# FORECAST_INITIALIZATION_TIME=2025-01-01T00:00:00
# FORECAST_LEAD_HOURS=24
# FORECAST_START_TIME=2025-01-01T00:00:00
# FORECAST_END_TIME=2025-01-05T00:00:00
# DATA_DOMAIN=lat_min,lat_max,lon_min,lon_max
# DATA_SPATIAL_RESOLUTION_KM=12
# INPUT_RESOLUTION_KM=12
# TARGET_RESOLUTION_KM=5
